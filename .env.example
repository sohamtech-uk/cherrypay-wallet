# Local development only. Copy to .env and use your own strong DB_PASSWORD.
DB_HOST=db
DB_PORT=5432
DB_NAME=cherrypay_wallet
DB_USER=wallet
DB_PASSWORD=replace_with_secure_local_password
WALLET_ORIGIN=http://localhost:5174
WALLET_WEB_PORT=5174

# Payments remain disabled until reviewed deployment/recovery evidence is provisioned.
WALLET_PAYMENTS_ENABLED=false
WEBAUTHN_RP_ID=localhost
# WALLET_PAYMENT_MANIFEST=/absolute/path/to/reviewed-public-manifest.json
# Inject STELLAR_RELAYER_SECRET through server secret storage; never commit it.


# Exchange Online mail via Microsoft Graph (app-only OAuth).
# Inject secrets from Azure Key Vault or deployment secret storage.
# App registration needs Microsoft Graph application Mail.Send permission
# with admin consent, restricted to the intended sender mailbox.
# AZURE_MAIL_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_MAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_MAIL_CLIENT_SECRET=inject_from_secret_store
# AZURE_MAIL_SENDER=wallet-notifications@example.com
