# Local development only. Copy to .env and use your own strong DB_PASSWORD.
DB_HOST=db
DB_PORT=5432
DB_NAME=cherrypay_wallet
DB_USER=wallet
DB_PASSWORD=replace_with_secure_local_password
WALLET_ORIGIN=http://localhost:5174
WALLET_WEB_PORT=5174

# Payments remain disabled until reviewed deployment/recovery evidence is provisioned.
WALLET_PAYMENTS_ENABLED=false
WEBAUTHN_RP_ID=localhost
# WALLET_PAYMENT_MANIFEST=/absolute/path/to/reviewed-public-manifest.json
# Inject STELLAR_RELAYER_SECRET through server secret storage; never commit it.


# Exchange Online mail via Microsoft Graph (app-only OAuth).
# Inject secrets from Azure Key Vault or deployment secret storage.
# App registration needs Microsoft Graph application Mail.Send permission
# with admin consent, restricted to the intended sender mailbox.
# AZURE_MAIL_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_MAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_MAIL_CLIENT_SECRET=inject_from_secret_store
# AZURE_MAIL_SENDER=wallet-notifications@example.com

# Shared Cherry Money Exchange Online settings
EXCHANGE_MAIL_SENDER_NAME="Cherry Money"
EXCHANGE_MAIL_INVOICE_FROM_EMAIL="hello@cherrymoney.co.uk"
EXCHANGE_MAIL_INVOICE_FROM_NAME="Cherry Money"
EXCHANGE_MAIL_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
EXCHANGE_MAIL_TIMEOUT=10
EXCHANGE_MAIL_CONNECT_TIMEOUT=5
EXCHANGE_MAIL_SAVE_TO_SENT_ITEMS=true
EXCHANGE_MAIL_FALLBACK_TO_MAIL=false
# AZURE_MAIL_SENDER can override the shared sender mailbox.
# Aurora has no supported Base Sepolia -> Stellar Testnet route. Keep funding disabled.
# Store the Studio key only on the API server. Never use a VITE_ variable for it.
AURORA_INTENTS_NETWORK=TESTNET
AURORA_INTENTS_ENABLED=false
# AURORA_INTENTS_API_KEY=
# Nansen does not currently support Stellar; no Nansen key is needed for coverage checks.

# Optional one-time 100,000 XLM Testnet allocations to verified C-wallets.
# Inject STELLAR_TESTNET_FAUCET_SECRET through server secret storage.
# Use a sufficiently funded Testnet treasury distinct from deployer and relayer.
# WALLET_DEPLOYMENT_PILOT_LIMIT=0 means no owner-count cap (optional cap: 1-1000).
