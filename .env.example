# Local development only. Copy to .env and use your own strong DB_PASSWORD.
DB_HOST=db
DB_PORT=5432
DB_NAME=cherrypay_wallet
DB_USER=wallet
DB_PASSWORD=replace_with_secure_local_password
WALLET_ORIGIN=http://localhost:5174
WALLET_WEB_PORT=5174

# Stellar Testnet payments (optional). Leave PAYMENT_RELAYER_SECRET empty to keep payments disabled.
# Sponsor (fee-payer) secret for a funded TESTNET account only. Never commit a real value.
PAYMENT_RELAYER_SECRET=
# Ledger to start transfer-event monitoring from (e.g. the wallet's deployment ledger).
PAYMENT_START_LEDGER=
# Context rule IDs read on-chain: transfer rule(s), and a separate rule holding the backup passkey.
SMART_ACCOUNT_TRANSFER_RULE_IDS=0
SMART_ACCOUNT_RECOVERY_RULE_ID=1
