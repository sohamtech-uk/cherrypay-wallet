{
  "openapi": "3.1.0",
  "info": {
    "title": "Cherry Pay Wallet Testnet Payment API",
    "version": "0.1.0",
    "description": "B3–B7 backend contract. Default server is disabled until verified B1/B2 session, contract and recovery adapters are composed. The P0 authentication adapter supplies a verified bearer session. No session is issued by this module."
  },
  "components": {
    "securitySchemes": {
      "WalletSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Verified owner session supplied by the B1/B2 authentication adapter; never an account ID."
      }
    },
    "schemas": {
      "Intent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "network",
          "destination",
          "amountStroops",
          "maxFeeStroops"
        ],
        "properties": {
          "network": {
            "const": "TESTNET",
            "type": "string"
          },
          "destination": {
            "type": "string",
            "minLength": 56,
            "maxLength": 56
          },
          "amountStroops": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "maxFeeStroops": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        }
      },
      "Approval": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authXdr"
        ],
        "properties": {
          "authXdr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      },
      "Attempt": {
        "type": "object",
        "required": [
          "id",
          "walletId",
          "network",
          "from",
          "destination",
          "amountStroops",
          "maxFeeStroops",
          "status",
          "createdAt",
          "verified",
          "feePayer"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "walletId": {
            "type": "string"
          },
          "network": {
            "const": "TESTNET"
          },
          "from": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "amountStroops": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "maxFeeStroops": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "status": {
            "enum": [
              "preparing",
              "awaiting_approval",
              "authorizing",
              "ready",
              "pending",
              "unknown",
              "confirmed",
              "failed",
              "rejected"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "verified": {
            "type": "boolean"
          },
          "feePayer": {
            "const": "sponsor"
          },
          "feeStroops": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Maximum authorized sponsored fee; not an exact charged fee."
          },
          "transactionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "eventId": {
            "type": "string"
          },
          "failureCode": {
            "type": "string"
          },
          "receipt": {
            "type": "string",
            "format": "uri"
          },
          "approval": {
            "type": "object",
            "required": [
              "authXdr",
              "expirationLedger",
              "expiresAt"
            ],
            "properties": {
              "authXdr": {
                "type": "string",
                "description": "Unsigned Soroban authorization entry. The B1/B2 contract signer fills only its signature."
              },
              "expirationLedger": {
                "type": "integer"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Wallet": {
        "type": "object",
        "required": [
          "id",
          "address",
          "network",
          "supportedDestinations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "network": {
            "const": "TESTNET"
          },
          "supportedDestinations": {
            "type": "array",
            "items": {
              "enum": [
                "classic",
                "contract"
              ]
            }
          }
        }
      },
      "AttemptPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "Transfer": {
        "type": "object",
        "required": [
          "id",
          "transactionHash",
          "ledger",
          "operationIndex",
          "eventIndex",
          "from",
          "to",
          "amountStroops",
          "closedAt",
          "verified",
          "receipt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "transactionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ledger": {
            "type": "integer"
          },
          "operationIndex": {
            "type": "integer"
          },
          "eventIndex": {
            "type": "integer"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "amountStroops": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "closedAt": {
            "type": "integer",
            "description": "Unix milliseconds"
          },
          "verified": {
            "const": true
          },
          "receipt": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "HistoryPage": {
        "type": "object",
        "required": [
          "network",
          "items"
        ],
        "properties": {
          "network": {
            "const": "TESTNET"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transfer"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "Balance": {
        "type": "object",
        "required": [
          "network",
          "address",
          "snapshot"
        ],
        "properties": {
          "network": {
            "const": "TESTNET"
          },
          "address": {
            "type": "string"
          },
          "snapshot": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "amountStroops",
                  "ledger",
                  "updatedAt"
                ],
                "properties": {
                  "amountStroops": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "ledger": {
                    "type": "integer"
                  },
                  "updatedAt": {
                    "type": "integer",
                    "description": "Unix milliseconds. Clients must display snapshot age."
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/wallets/{walletId}": {
      "parameters": [
        {
          "name": "walletId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read owned wallet",
        "security": [
          {
            "WalletSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Persisted result; pending is not confirmation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No verified session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Untrusted mutation origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No owned resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting intent, unresolved payment or state transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Integration/RPC unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
